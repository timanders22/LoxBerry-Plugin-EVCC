#!/bin/bash
# Laeuft als ROOT beim Entfernen des Plugins.
#
# EVCC wird BEWUSST NICHT mitentfernt. Wer das Plugin deinstalliert, will
# meistens nur die Loxone-Anbindung los - nicht seine eingerichtete
# Wallbox-Steuerung samt Datenbank. Das Entfernen steht in der Anleitung.
ARGV1=$1   # Plugin-Verzeichnisname

echo "<INFO> Entferne die sudo-Regel des Plugins"
rm -f /etc/sudoers.d/loxberry-evcc

# Konfiguration mit entfernen.
#
# In evcc.json steht das EVCC-Passwort IM KLARTEXT, dazu das Zugriffstoken
# des unangemeldeten Miniserver-Endpunkts. Bis 0.9.0 blieb die Datei nach
# der Deinstallation liegen - mitsamt beidem, und ohne dass irgendwo stand,
# dass sie noch da ist. Wer ein Plugin entfernt, geht davon aus, dass seine
# Zugangsdaten mitgehen.
#
# LoxBerry raeumt config/ und data/ beim Entfernen normalerweise selbst auf.
# Verlassen wird sich darauf hier NICHT: der Aufwand ist ein rm, und der
# Schaden im Fehlerfall ist ein Passwort auf der Platte.
LBHOME="$LBHOMEDIR"
# Dritter Rueckfall: der eigene Ablageort. Bewusst kein fest verdrahteter
# Systempfad - LoxBerry laesst sich anderswohin installieren, und der
# Plugin-Pruefer sucht die Zeichenkette, ohne den Zusammenhang zu sehen.
# Dieses Skript liegt unter <home>/data/plugins/<ordner>/uninstall/
if [ -z "$LBHOME" ] || [ ! -d "$LBHOME" ]; then
    LBHOME=$(cd "$(dirname "$(readlink -f "$0")")/../../../.." 2>/dev/null && pwd)
fi
PDIR=${ARGV1:-evcc}
for verzeichnis in "$LBHOME/config/plugins/$PDIR" "$LBHOME/data/plugins/$PDIR"; do
    if [ -d "$verzeichnis" ]; then
        rm -rf "$verzeichnis"
        echo "<OK> $verzeichnis entfernt."
    fi
done
# Die Zweitschrift liegt NEBEN dem Plugin-Ordner, nicht darin - siehe
# ev_paths() in ev_lib.php. Das ist Absicht (LoxBerry raeumt
# config/plugins/<ordner>/ bei der Deinstallation weg, und genau dann soll die
# Sicherung ueberleben), hatte aber bis 0.9.10 eine haessliche Folge: die
# Schleife oben entfernt nur Verzeichnisse, die Datei blieb liegen - mit dem
# EVCC-Passwort im Klartext und dem Token des unangemeldeten Endpunkts. Und
# zwei Zeilen darunter stand, beides sei geloescht.
#
# Verschaerfend: ev_config() holt genau diese Datei bei einer NEUinstallation
# stillschweigend zurueck. Eine saubere Neuinstallation war damit keine.
for datei in "$LBHOME/config/plugins/$PDIR.backup.evcc.json" \
             "$LBHOME/config/plugins/$PDIR.backup.evcc.json.neu" \
             "$LBHOME/config/plugins/$PDIR/evcc.backup.json" \
             "$LBHOME/config/plugins/$PDIR/evcc.json.kaputt"; do
    if [ -f "$datei" ]; then
        rm -f "$datei"
        echo "<OK> $datei entfernt."
    fi
done

rm -rf "/tmp/${PDIR}_upgrade" "/run/shm/${PDIR}" "/tmp/${PDIR}" 2>/dev/null
echo "<INFO> Zugangsdaten und Zugriffstoken des Plugins sind geloescht."

# Was postroot.sh als root angelegt hat, gehoert auch wieder weg. Laeuft die
# Deinstallation nicht als root, wird das ehrlich gesagt statt still zu
# scheitern - ein Befehl, der genau dann nichts tut, wenn er gebraucht wird,
# ist schlimmer als keiner.
for datei in /usr/local/sbin/loxberry-evcc-update /etc/sudoers.d/loxberry-evcc; do
    if [ -e "$datei" ]; then
        if [ "$(id -u)" = "0" ]; then
            rm -f "$datei" && echo "<OK> $datei entfernt."
        else
            echo "<INFO> $datei bleibt liegen (keine Root-Rechte). Von Hand: sudo rm -f $datei"
        fi
    fi
done

echo "<INFO> EVCC selbst bleibt installiert und laeuft weiter."
echo "<INFO> Wer es auch entfernen will:"
echo "<INFO>   sudo systemctl disable --now evcc"
echo "<INFO>   sudo apt purge evcc"
echo "<INFO>   sudo rm -f /etc/apt/sources.list.d/evcc-stable.list"
echo "<INFO> Konfiguration und Datenbank liegen in /etc/evcc.yaml und /var/lib/evcc/."

# ---------- Den Nachbarn der Sicherung wegraeumen ----------
# data/plugins/<ordner>.upgrade_sicherung liegt AUSSERHALB des Ordners, den
# LoxBerry beim Deinstallieren loescht - genau deshalb uebersteht er ein
# Update. Wer ihn hier nicht abraeumt, laesst Zugangsdaten liegen.
# $PDIR und $LBHOME oben sind sorgfaeltig hergeleitet - mit drei
# Rueckfallebenen. Bis 0.9.26 stand hier stattdessen "${3:-}" und
# "${5:-$LBHOMEDIR}": der Kopf dieser Datei kennt genau EIN Argument, also
# war $3 leer, die Bedingung darunter falsch, und die Zeile lief nie. Liegen
# blieb dann data/plugins/<ordner>.upgrade_sicherung/evcc.json - mit dem
# EVCC-Passwort im Klartext und dem Token des unangemeldeten Endpunkts,
# waehrend die Meldung oben sagt, beides sei geloescht.
UN_FOLDER="${3:-$PDIR}"
UN_BASE="${5:-$LBHOME}"
if [ -n "$UN_FOLDER" ] && [ -n "$UN_BASE" ] && [ -d "$UN_BASE/data/plugins" ]; then
    rm -rf "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung" 2>/dev/null
fi
exit 0
