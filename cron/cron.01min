#!/bin/bash
# Minuetlicher Lauf. Der eigentliche Abruf laeuft feiner - siehe ev_abruf.php:
# das Skript schleift innerhalb der Minute im eingestellten Takt weiter, damit
# Loxone nicht bis zu 60 s auf neue Werte wartet.
#
# WARUM DIE FEHLERAUSGABE NICHT MEHR NACH /dev/null GEHT
# Bis 0.9.10 stand hier ">/dev/null 2>&1". Genau das hat den Fehler der
# Fassung 0.9.8 verdeckt: ev_abruf.php brach bei JEDEM Lauf mit
# "Failed opening required" ab, schrieb das auf die Fehlerausgabe - und die
# ging ins Nichts. Aufgefallen ist es erst Fassungen spaeter. Seit 0.9.9
# schreibt der Dienst im Fehlerfall ausdruecklich hin, welche Datei er wo
# gesucht hat; diese Auskunft wegzuwerfen waere die halbe Korrektur.
#
# Die regulaere Ausgabe bleibt still (sonst schreibt der Cron jede Minute),
# die FEHLERausgabe landet in einer eigenen Datei neben dem Protokoll.
#
# Und der Aufruf geht ausdruecklich ueber php: fehlt der Datei einmal das
# Ausfuehrungsrecht, scheiterte der direkte Aufruf ebenso wortlos.
#
# SEIT 0.9.34 (I3, Regeln/06):
#   - Als root von Hand gestartet, gibt die Datei an loxberry ab; gibt es den
#     Benutzer nicht, geschieht nichts - und nichts entsteht root-eigen
#     (ev_abruf.php lehnt root ausserdem selbst ab, C12).
#   - Waehrend einer Aktualisierung (Marke <ordner>.upgrade_laeuft) ruht der
#     Takt still; postupgrade.sh raeumt die Marke ab.
#   - Der Protokollordner wird angelegt, sonst scheitert schon die Umlenkung
#     und php startet gar nicht - ohne Spur (Pruefbericht installer, B5).
#   - cron.err bekommt ein touch: ein Anhaengen ohne Inhalt frischt die
#     Aenderungszeit nicht auf (Regeln/06, Abfahrts-Assistent 1.6.10).
BIN="REPLACELBPBINDIR"
LOGD="REPLACELBPLOGDIR"
DATA="REPLACELBPDATADIR"

if [ "$(id -u 2>/dev/null)" = "0" ]; then
    if id loxberry >/dev/null 2>&1; then
        exec su -s /bin/bash loxberry -c "$(printf '%q' "$0")"
    fi
    echo "EVCC: als root gestartet, einen Benutzer loxberry gibt es nicht - der Abruf laeuft nicht." >&2
    exit 1
fi

[ -e "$DATA.upgrade_laeuft" ] && exit 0

ERR="$LOGD/cron.err"
mkdir -p "$LOGD" 2>/dev/null
# 0.9.50 (Nachzug 01.11.2026, Bauart Renault NG 2.1.23): touch allein genuegt nicht - es gelingt auch auf einem
# Verzeichnis und, beim Eigentuemer, auf einer schreibgeschuetzten Datei. Bis 0.9.49 brach dann die Umlenkung
# den Befehl ab, BEVOR er startete.
if [ -e "$ERR" ] && { [ ! -f "$ERR" ] || [ ! -w "$ERR" ]; }; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Cron: $ERR ist nicht beschreibbar - Fehlermeldungen des Abrufs gehen verloren." >> "$LOGD/evcc.log" 2>/dev/null
    ERR=/dev/null
else
    touch "$ERR" 2>/dev/null || ERR=/dev/null
fi
php "$BIN/ev_abruf.php" cron >/dev/null 2>>"$ERR"
